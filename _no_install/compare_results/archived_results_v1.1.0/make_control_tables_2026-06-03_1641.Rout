> 
> surf_avg_len_country_tbl <- add_control_comment(make_surf_stat_control_tbl(tfr_surfs_lst, stat = "avg_len"))
> saveRDS(surf_avg_len_country_tbl, file = archived_tab_surf_stats_avg_len_prob_filepath)
